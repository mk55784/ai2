        <li>Your controller at <code>C:/Users/mk55784/Desktop/ai2/lab2/src/Controller/WeatherController.php</code></li>
        <li>Your template at <code>C:/Users/mk55784/Desktop/ai2/lab2/templates/weather/index.html.twig</code></li>
    </ul>
</div>
{% endblock %}
